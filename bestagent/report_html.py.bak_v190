#!/usr/bin/env python3
"""report_html.py — 本地 HTML 报告渲染器（数据/展示分离：LLM 只产结构化 JSON，页面由本地模板渲染）

背景（2026-09-05 老板拍板方向）：
- 产物是资产、UI 是壳。结构化 JSON（pool_report / collected / 将来的打招呼数据）= 资产；
  HTML 只是随时可由本地代码重新生成的展示层——换壳（弃 Streamlit / 上桌面）不废。
- 参考老实现：岗位招聘单机版 services/report_generator.py（Python f-string）、
  wails internal/report/report.go（Go html/template）。
- 避免让 LLM 手写整份 HTML（大输出 → 截断风险、费 token、不可控）；HTML 渲染零 token、确定性、永不断流。

用法：
  python report_html.py --report data/chat/<job>/reports/pool_report_*.json \
      --collect data/chat/<job>/reports/collected_*.json \
      --out data/chat/<job>/reports/候选人匹配_<ts>.html \
      [--title "岗位名"] [--group none|verdict|city]

输入数据格式（与 m2_eval_run / 面板③ 输出一致）：
  pool_report = {"pool_quality": {"pool_quality": "中", "match_distribution": {...}, "main_gaps": [...],
                 "strengths": [...], "recommendation": "...", "data_valid": ..., "data_valid_message": "..."},
                 "candidates": [{"candidate_id": 1, "score": 0-100, "verdict": "推荐/待定/不推荐",
                                 "match_points": [...], "concerns": [...], "summary": "..."}]}
  collected  = {"rows": [{"fields": {"res_id_encode": "..."}, "text": "..."}]}（rows 数组顺序 = candidate_id 1..N）

将来扩展：若候选人 dict 带 话术1/话术2/先核实/概况（④ 打招呼数据），卡片自动加话术区；无需改渲染逻辑。
"""
from __future__ import annotations

import argparse
import html
import json
import sys
from datetime import datetime
from pathlib import Path

try:
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
except Exception:
    pass

DETAIL_URL = "https://h.liepin.com/resume/showresumedetail/?res_id_encode={rid}"

VERDICT_META = {
    "推荐": {"cls": "rec", "label": "✅ 推荐"},
    "待定": {"cls": "hold", "label": "🟡 待定"},
    "不推荐": {"cls": "no", "label": "🔴 不推荐"},
}


def esc(x) -> str:
    return html.escape(str(x or ""), quote=True)


def parse_collected(path: Path) -> list[dict]:
    """读 collected JSON，返回与 candidate_id 对齐的行列表（rows 顺序 1..N）。"""
    if not path or not path.exists():
        return []
    data = json.loads(path.read_text(encoding="utf-8-sig"))
    return (data.get("rows") or []) if isinstance(data, dict) else []


def best_name(row: dict) -> str:
    """尽力从 raw text 里抠姓名（掩码如 张**）；抠不到就返回空。"""
    text = (row.get("text") or "") if isinstance(row, dict) else ""
    for line in text.split("\n"):
        s = line.strip()
        if "**" in s and len(s) <= 12 and not s.startswith(("工作", "硕士", "本科", "博士")):
            return s
    return ""


def detail_link(row: dict) -> str:
    fields = (row.get("fields") or {}) if isinstance(row, dict) else {}
    rid = fields.get("res_id_encode") or row.get("res_id_encode") or row.get("source_id")
    return DETAIL_URL.format(rid=rid) if rid else None


def text_snippet(row: dict, limit: int = 300) -> str:
    t = ((row.get("text") or "") if isinstance(row, dict) else "").strip()
    if not t:
        return ""
    return t if len(t) <= limit else t[:limit] + "…"


# ── 发岗助手渲染（v1.6.8：📋 生成发岗文字 → 逐格复制到猎聘发岗表单）─────────
# 输入与 data/prompts/publish_manual.txt 的 JSON 契约一致：
#   {company_name, job_title_original, job_title_normalized, city, salary_original,
#    salary_benefits, work_years, education, headcount,
#    responsibilities[], requirements[], priority_notes[], compliance_issues[]}
#   可选 salary_converted（本地换算，如 "50-120万/18薪" → "42-100K·18薪"）
# 展示按猎聘发岗表单的格子排：每格一个可编辑输入框 + 「复制此格」按钮；职位描述本地拼。

PUB_FIELD_DEFS = [
    ("company_name", "1️⃣ 招聘企业", False),
    ("job_title_normalized", "2️⃣ 职位名称", True),   # 显示原始名对照
    ("city", "3️⃣ 工作城市", False),
    ("salary_display", "4️⃣ 职位薪资", False),         # 显示换算后 + 原始
    ("salary_benefits", "5️⃣ 薪资福利", False),
    ("work_years", "6️⃣ 工作年限", False),
    ("education", "7️⃣ 学历要求", False),
    ("headcount", "8️⃣ 招聘人数", False),
    ("job_description", "9️⃣ 职位描述（岗位职责/任职要求/优先考虑）", False),
]


def _pub_field_value(pub: dict, key: str) -> str:
    """渲染值：本地换算/拼装优先，LLM 原始字段兜底。"""
    if key == "salary_display":
        conv = (pub.get("salary_converted") or {}).get("converted") if isinstance(pub.get("salary_converted"), dict) else None
        return conv or (pub.get("salary_original") or "")
    if key == "job_description":
        parts = []
        resp = pub.get("responsibilities") or []
        if resp:
            parts.append("【岗位职责】")
            parts.append("\n".join(f"{i}. {x}" for i, x in enumerate(resp, 1)))
        req = pub.get("requirements") or []
        if req:
            parts.append("【任职要求】")
            parts.append("\n".join(f"• {x}" for x in req))
        pri = pub.get("priority_notes") or []
        if pri:
            parts.append("【优先考虑】")
            parts.append("\n".join(f"• {x}" for x in pri))
        return "\n\n".join(parts)
    v = pub.get(key)
    if isinstance(v, list):
        return "\n".join(str(x) for x in v)
    return str(v or "")


def _pub_orig(pub: dict, key: str) -> str:
    """原始值对照（职位名称/薪资 显示 LLM 提取的原文，供老板核对）。"""
    if key == "job_title_normalized":
        o = pub.get("job_title_original")
        n = pub.get("job_title_normalized")
        return f"📌 原始：{o}" if o and o != n else ""
    if key == "salary_display":
        s = pub.get("salary_original")
        conv = pub.get("salary_converted") if isinstance(pub.get("salary_converted"), dict) else None
        if s and conv and conv.get("converted"):
            return f"📌 换算：{s} / {conv.get('months', 12)}薪 → {conv.get('converted')}"
        return f"📌 原始：{s}" if s else ""
    return ""


def render_publish(job_title: str, pub: dict) -> str:
    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    comp = (pub.get("compliance_issues") or [])
    warn = ""
    if comp:
        items = "".join(f"<li>{esc(x)}</li>" for x in comp)
        warn = (f'<div class="pub-warn"><b>⚠️ 已自动过滤以下不合规内容（发岗前请知悉）</b>'
                f'<ul>{items}</ul></div>')

    rows = []
    for key, label, _show_orig in PUB_FIELD_DEFS:
        val = _pub_field_value(pub, key)
        orig = _pub_orig(pub, key)
        rows.append(f"""<div class="pub-row" data-key="{esc(key)}">
      <div class="pub-head"><span class="pub-label">{esc(label)}</span>
        <span class="pub-btns"><button class="pub-copy" data-key="{esc(key)}">📋 复制此格</button></span></div>
      <textarea class="pub-input" data-key="{esc(key)}" rows="{6 if key == 'job_description' else 2}" ondblclick="this.select()">{esc(val)}</textarea>
      {f'<div class="pub-orig">{esc(orig)}</div>' if orig else ''}
    </div>""")
    rows_html = "\n".join(rows)

    return f"""<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{esc(job_title)} · 发岗助手</title>
<style>
  body{{font-family:-apple-system,"Segoe UI","Microsoft YaHei",sans-serif;background:#f2f4f8;margin:0;padding:20px;color:#1f2937;}}
  .wrap{{max-width:760px;margin:0 auto;}}
  h1{{font-size:20px;margin:0 0 2px;}}
  .meta{{color:#6b7280;font-size:12px;margin-bottom:14px;}}
  .tip{{background:#eff6ff;border:1px solid #bfdbfe;border-radius:8px;padding:8px 12px;font-size:13px;margin-bottom:12px;}}
  .pub-warn{{background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:8px 12px;font-size:13px;margin-bottom:12px;}}
  .pub-warn ul{{margin:4px 0 0 20px;padding:0;}} .pub-warn li{{color:#92400e;}}
  .pub-row{{background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:10px 14px;margin-bottom:10px;}}
  .pub-head{{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;}}
  .pub-label{{font-weight:600;font-size:14px;}}
  .pub-copy{{background:#2563eb;color:#fff;border:0;border-radius:8px;padding:4px 12px;cursor:pointer;font-size:12px;}}
  .pub-copy:hover{{background:#1d4ed8;}}
  .pub-input{{width:100%;box-sizing:border-box;border:1px solid #d1d5db;border-radius:8px;padding:6px 10px;font-size:14px;font-family:inherit;resize:vertical;}}
  .pub-input:focus{{outline:2px solid #bfdbfe;border-color:#3b82f6;}}
  .pub-orig{{color:#9ca3af;font-size:12px;margin-top:4px;}}
  .bar{{display:flex;gap:10px;margin-bottom:16px;}}
  .bar button{{flex:1;padding:8px 0;border-radius:8px;font-size:13px;cursor:pointer;border:0;}}
  .btn-copy-all{{background:#10b981;color:#fff;}}
  .btn-copy-all:hover{{background:#059669;}}
  .footer{{text-align:center;margin-top:16px;color:#9ca3af;font-size:12px;}}
</style>
</head>
<body>
<div class="wrap">
  <h1>📤 {esc(job_title)} · 发岗助手</h1>
  <div class="meta">本地渲染（LLM 只产字段 JSON，本页可随时重生）· 生成 {esc(now)}</div>
  <div class="tip">💡 打开猎聘「发布职位」页与此页并排：逐格点「复制此格」→ 粘贴到对应输入框；职位描述整段复制到正文框。若某格复制失败，双击输入框可全选，再按 Ctrl+C。</div>
  {warn}
  <div class="bar">
    <button class="btn-copy-all" id="copyAll">📋 一键复制全部字段（带标签）</button>
  </div>
  {rows_html}
  <div class="footer">小猎工作台产物 · 数据资产在 reports/publish_*.json，本页可随时重新生成</div>
</div>
<script>
  function g(k){{ var el = document.querySelector('textarea[data-key="'+k+'"]'); return el ? el.value : ''; }}
  async function copy(t, msg) {{
    var ok = false;
    try {{ await navigator.clipboard.writeText(t); ok = true; }} catch(e) {{
      var ta = document.createElement('textarea'); ta.value = t; document.body.appendChild(ta);
      ta.select(); try {{ ok = document.execCommand('copy'); }} catch(_) {{ ok = false; }}
      document.body.removeChild(ta);
    }}
    var tip = document.createElement('div');
    tip.textContent = ok ? '✅ 已复制' : '❌ 复制失败：请双击输入框全选 → Ctrl+C';
    tip.style.cssText = 'position:fixed;top:16px;right:16px;background:' + (ok ? '#10b981' : '#dc2626') +
      ';color:#fff;padding:6px 14px;border-radius:8px;z-index:99;max-width:70vw;';
    document.body.appendChild(tip); setTimeout(function(){{ tip.remove(); }}, ok ? 1200 : 4000);
  }}
  document.querySelectorAll('.pub-copy').forEach(function(btn){{
    btn.addEventListener('click', function(){{ var k = btn.getAttribute('data-key'); copy(g(k), btn); }});
  }});
  document.getElementById('copyAll').addEventListener('click', function(){{
    var keys = {json.dumps([d[0] for d in PUB_FIELD_DEFS], ensure_ascii=False)};
    var labels = {json.dumps({d[0]: d[1] for d in PUB_FIELD_DEFS}, ensure_ascii=False)};
    var parts = [];
    keys.forEach(function(k){{ var v = g(k); parts.push(labels[k] + '：' + (v || '未提供')); }});
    copy(parts.join('\\n'), this);
  }});
</script>
</body>
</html>"""


def render(job_title: str, pool: dict, candidates: list[dict],
           collected_rows: list[dict], group: str = "none") -> str:
    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    total = len(candidates)
    n_rec = sum(1 for c in candidates if c.get("verdict") == "推荐")
    n_hold = sum(1 for c in candidates if c.get("verdict") == "待定")
    n_no = sum(1 for c in candidates if c.get("verdict") == "不推荐")

    # 池评区（pool_quality 可能是 dict，也可能是旧格式字符串）
    pq = pool.get("pool_quality") if isinstance(pool, dict) else pool
    pq_html = ""
    if isinstance(pq, dict):
        chips = []
        for k in ("pool_quality", "recommendation"):
            if pq.get(k):
                chips.append(f'<span class="chip">{esc(pq[k])}</span>')
        dist = pq.get("match_distribution") or {}
        dist_txt = " / ".join(f"{k} {v}" for k, v in dist.items() if k in ("high", "medium", "low", "total"))
        if dist_txt:
            chips.append(f'<span class="chip">分布 {esc(dist_txt)}</span>')
        dv = pq.get("data_valid")
        if dv is not None:
            dv_cls = "ok" if dv else "warn"
            dv_txt = "data_valid ✅通过" if dv else "data_valid ⚠️异常"
            chips.append(f'<span class="chip {dv_cls}">{esc(dv_txt)}</span>')
        lists = ""
        if pq.get("main_gaps"):
            lists += '<div class="kv"><b>主要缺口：</b><ul class="red">' + "".join(f"<li>{esc(x)}</li>" for x in pq["main_gaps"]) + "</ul></div>"
        if pq.get("strengths"):
            lists += '<div class="kv"><b>优势：</b><ul class="green">' + "".join(f"<li>{esc(x)}</li>" for x in pq["strengths"]) + "</ul></div>"
        if pq.get("data_valid_message"):
            lists += f'<div class="kv"><b>数据校验：</b>{esc(pq["data_valid_message"])}</div>'
        pq_html = f'<div class="poolbox"><div class="poolchips">{"".join(chips)}</div>{lists}</div>'
    elif pq:
        pq_html = f'<div class="poolbox"><span class="chip">{esc(pq)}</span></div>'

    # 候选人卡片
    cards = []
    for idx, c in enumerate(sorted(candidates, key=lambda x: -int(x.get("score") or 0)), 1):
        cid = c.get("candidate_id")
        row = collected_rows[cid - 1] if collected_rows and 0 < cid <= len(collected_rows) else {}
        verdict = c.get("verdict") or ""
        meta = VERDICT_META.get(verdict, {"cls": "no", "label": esc(verdict)})
        score = c.get("score")
        try:
            sc = int(score)
            sc_cls = "high" if sc >= 80 else ("mid" if sc >= 60 else "low")
        except (TypeError, ValueError):
            sc, sc_cls = score, "low"
        name = best_name(row) or f"候选人 #{cid}"
        link = detail_link(row)
        link_html = f'<a class="btn" href="{esc(link)}" target="_blank" rel="noopener">🔗 猎聘直达（新标签）</a>' if link else ""
        points = "".join(f"<li>{esc(p)}</li>" for p in (c.get("match_points") or [])) if c.get("match_points") else ""
        concerns = "".join(f"<li>{esc(x)}</li>" for x in (c.get("concerns") or [])) if c.get("concerns") else ""
        greet = ""
        if c.get("概况") or c.get("话术1") or c.get("话术2") or c.get("先核实"):
            g1 = f'<div class="g-item"><span class="g-label">话术1 · 岗位亮点</span>{esc(c.get("话术1"))}</div>' if c.get("话术1") else ""
            g2 = f'<div class="g-item"><span class="g-label">话术2 · 匹配理由</span>{esc(c.get("话术2"))}</div>' if c.get("话术2") else ""
            gv = f'<div class="g-item"><span class="g-label">概况</span>{esc(c.get("概况"))}</div>' if c.get("概况") else ""
            gc = f'<div class="g-item"><span class="g-label">先核实</span>{esc(c.get("先核实"))}</div>' if c.get("先核实") else ""
            greet = f'<div class="greeting">{gv}{gc}{g1}{g2}</div>'
        snippet = text_snippet(row)
        det = f"<details class='snippet'><summary>列表摘要（展开）</summary><pre>{esc(snippet)}</pre></details>" if snippet else ""
        cards.append(f"""
    <div class="candidate v-{meta['cls']}" data-v="{esc(verdict)}">
      <div class="chead">
        <span class="score {sc_cls}">{esc(sc)}</span>
        <span class="vtag {meta['cls']}">{meta['label']}</span>
        <span class="cname">{esc(name)}</span>
        <span class="cid">#{esc(cid)}</span>
        {link_html}
      </div>
      <div class="summ">{esc(c.get('summary'))}</div>
      {('<div class="points"><b>✅ 匹配点</b><ul>' + points + '</ul></div>') if points else ''}
      {('<div class="concerns"><b>⚠️ 疑虑点</b><ul>' + concerns + '</ul></div>') if concerns else ''}
      {greet}
      {det}
    </div>""")
    cards_html = "".join(cards)

    body_g = ""
    if group == "verdict":
        body_g = ('<div class="filters"><button class="f active" data-f="all">全部</button>'
                  '<button class="f" data-f="推荐">推荐</button>'
                  '<button class="f" data-f="待定">待定</button>'
                  '<button class="f" data-f="不推荐">不推荐</button></div>')

    return f"""<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{esc(job_title)} · 匹配报告</title>
<style>
  body{{font-family:-apple-system,"Segoe UI","Microsoft YaHei",sans-serif;background:#f2f4f8;margin:0;padding:20px;color:#1f2937;}}
  .wrap{{max-width:1000px;margin:0 auto;}}
  h1{{font-size:20px;margin:0 0 2px;}}
  .meta{{color:#6b7280;font-size:12px;margin-bottom:14px;}}
  .poolbox{{background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:12px 16px;margin-bottom:14px;}}
  .poolchips .chip{{display:inline-block;background:#eef2ff;border:1px solid #c7d2fe;border-radius:999px;padding:2px 10px;font-size:12px;margin:2px 4px 2px 0;}}
  .chip.ok{{background:#ecfdf5;border-color:#a7f3d0;}}
  .chip.warn{{background:#fffbeb;border-color:#fde68a;}}
  .kv{{font-size:13px;margin:6px 0;}}
  .kv ul{{margin:2px 0;padding-left:20px;}}
  ul.red li{{color:#b91c1c;}} ul.green li{{color:#047857;}}
  .filters{{margin:10px 0;}}
  .f{{border:1px solid #d1d5db;background:#fff;border-radius:8px;padding:4px 12px;margin-right:6px;cursor:pointer;font-size:13px;}}
  .f.active{{background:#2563eb;border-color:#2563eb;color:#fff;}}
  .candidate{{background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:14px 16px;margin-bottom:12px;}}
  .chead{{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:8px;}}
  .score{{font-weight:700;padding:2px 10px;border-radius:999px;color:#fff;font-size:13px;}}
  .score.high{{background:#10b981;}} .score.mid{{background:#f59e0b;}} .score.low{{background:#ef4444;}}
  .vtag{{font-size:12px;padding:1px 8px;border-radius:999px;}}
  .vtag.rec{{background:#d1fae5;color:#065f46;}} .vtag.hold{{background:#fef3c7;color:#92400e;}} .vtag.no{{background:#fee2e2;color:#991b1b;}}
  .cname{{font-weight:600;font-size:15px;}} .cid{{color:#9ca3af;font-size:12px;}}
  .btn{{margin-left:auto;background:#2563eb;color:#fff;text-decoration:none;font-size:12px;padding:5px 12px;border-radius:8px;}}
  .btn:hover{{background:#1d4ed8;}}
  .summ{{font-size:13px;color:#374151;margin-bottom:6px;}}
  .points,.concerns{{font-size:13px;margin:4px 0;}}
  .points ul,.concerns ul{{margin:2px 0;padding-left:20px;}}
  .points li{{color:#047857;}} .concerns li{{color:#b91c1c;}}
  .greeting{{background:#fff7ed;border-left:3px solid #fb923c;padding:8px 12px;border-radius:4px;margin-top:8px;font-size:13px;}}
  .g-item{{margin-top:4px;}} .g-label{{display:inline-block;background:#fef3c7;color:#92400e;font-size:11px;padding:1px 8px;border-radius:999px;margin-right:6px;font-weight:600;}}
  details.snippet{{margin-top:8px;}} details.snippet summary{{cursor:pointer;color:#6b7280;font-size:12px;}}
  details.snippet pre{{background:#f9fafb;border:1px solid #e5e7eb;border-radius:6px;padding:8px;font-size:12px;white-space:pre-wrap;font-family:inherit;}}
  .footer{{text-align:center;margin-top:18px;color:#9ca3af;font-size:12px;}}
</style>
</head>
<body>
<div class="wrap">
  <h1>📊 {esc(job_title)} · 候选人匹配报告</h1>
  <div class="meta">本地渲染（数据来源：结构化 JSON，非 LLM 手写）· 生成 {esc(now)} · 共 {esc(total)} 人
    （推荐 {n_rec} / 待定 {n_hold} / 不推荐 {n_no}）</div>
  {pq_html}
  {body_g}
  {cards_html}
  <div class="footer">小猎工作台产物 · 数据资产在 reports/*.json，本页可随时重新生成</div>
</div>
<script>
  document.querySelectorAll('.f').forEach(function(btn){{
    btn.addEventListener('click', function(){{
      document.querySelectorAll('.f').forEach(function(b){{b.classList.remove('active');}});
      btn.classList.add('active');
      var f = btn.getAttribute('data-f');
      document.querySelectorAll('.candidate').forEach(function(c){{
        c.style.display = (f === 'all' || c.getAttribute('data-v') === f) ? '' : 'none';
      }});
    }});
  }});
</script>
</body>
</html>"""


# ── ① 岗前分析 · 过程文档：本地渲染（2026-09-15 第二刀）──────────────────────────
# 背景（【已实测】，见 省token第一刀·衔接报告 §4.1-A / §7-4）：
#   · 这份过程网页原先由 LLM **手写整份 HTML**，而且**没有长度上限**——
#     盘上 8 份真网页 9,389 ~ 24,148 字节；同一次重跑里它自己从 9,439 涨到 13,065 字符（+38%）；
#     结果是第一刀省下的 token 被 output 涨回去（8,923 → 10,200）。
#   · 改法与 render_publish 同一套路：**LLM 只交内容字段，页面本地渲染**。
#     事实层面（读了什么/来源/字节数）本地代码就知道；判断层面（评分/风险/结论）已在 analyze JSON 里；
#     真正只有它知道的只剩「关键字怎么选的 / 要核实什么 / 下一步」→ 这正是 process 块（有硬预算）。
# 边界（与 local_checks 同一条纪律）：**本模块只搬运与排版，不判断内容好坏、不改判断结论**；
#   长度预算只掐「过程叙述」这块新增内容，**评分/风险/建议一个字不截**。

ANALYZE_BUDGET = {
    "keyword_reasoning": 250,  # 字符串上限（字符）
    "verify_item": 50,         # 待核实清单：单条上限
    "verify_list": 5,          # 待核实清单：条数上限
    "next_step": 100,          # 字符串上限
    "total": 600,              # process 块合计硬顶（= 250 + 5×50 + 100）
}

ANALYZE_REC_META = {
    "接单": {"cls": "rec", "label": "建议接单"},
    "沟通": {"cls": "hold", "label": "先沟通再定"},
    "放弃": {"cls": "no", "label": "建议别做"},
}
ANALYZE_DIM_LABELS = (
    ("commission", "佣金"), ("hc_count", "HC 数量"), ("freshness", "新鲜度"),
    ("upstream", "上游靠谱度"), ("difficulty", "匹配难度"),
)


def _analyze_ts(name: str) -> str:
    """从 analyze_YYYYMMDD-HHMMSS.json 文件名还原产出时间（老命名带下划线也认）。"""
    import re
    m = re.search(r"(\d{8})[-_](\d{6})", str(name or ""))
    if not m:
        return ""
    d, t = m.group(1), m.group(2)
    return f"{d[:4]}-{d[4:6]}-{d[6:8]} {t[:2]}:{t[2:4]}:{t[4:6]}"


def _clip(x, limit: int) -> tuple[str, bool]:
    """硬约束到 limit 字符（省略号本身也算进去）——预算是硬顶，不是"大约"。

    2026-09-15 冒烟实测：原写法 `s[:limit] + "…"` 会返回 limit+1 个字符，
    于是「超预算已截断」的字段反而**越过了上限**（251/250、607/600）→ 预算形同虚设，已修。
    """
    s = str(x or "").strip()
    if len(s) <= limit:
        return s, False
    return s[: max(0, limit - 1)].rstrip() + "…", True


def clip_process(data: dict) -> tuple[dict, dict]:
    """把 analyze JSON 的 process 块按 ANALYZE_BUDGET 收敛（本地强制）。返回 (收敛后, 用量)。

    老报告（2026-09-15 之前）没有 process 块 → 返回空块 + present=False，页面照渲染（不报错）。
    """
    raw = data.get("process") if isinstance(data.get("process"), dict) else {}
    usage = {"present": bool(raw), "chars": {}, "truncated": [], "total": 0,
             "budget": ANALYZE_BUDGET["total"]}
    kr, c1 = _clip(raw.get("keyword_reasoning"), ANALYZE_BUDGET["keyword_reasoning"])
    if c1:
        usage["truncated"].append("keyword_reasoning")
    ns, c2 = _clip(raw.get("next_step"), ANALYZE_BUDGET["next_step"])
    if c2:
        usage["truncated"].append("next_step")
    items = raw.get("verify_list") or []
    if isinstance(items, str):
        items = [items]
    vl = []
    for i, it in enumerate(items):
        if i >= ANALYZE_BUDGET["verify_list"]:
            usage["truncated"].append("verify_list 条数")
            break
        s, cut = _clip(it, ANALYZE_BUDGET["verify_item"])
        if cut:
            usage["truncated"].append("verify_list 单条")
        if s:
            vl.append(s)
    usage["chars"] = {"keyword_reasoning": len(kr), "verify_list": sum(len(x) for x in vl),
                      "next_step": len(ns)}
    usage["total"] = sum(usage["chars"].values())
    return {"keyword_reasoning": kr, "verify_list": vl, "next_step": ns}, usage


def render_analyze(job_title: str, data: dict, meta: dict | None = None) -> str:
    """① 岗前分析 · 过程文档（本地渲染，0 token、确定性、有长度预算）。

    meta（全可选）：job_code / created_at / first_time / jd_bytes / artifacts_count / rules_used
    """
    meta = meta or {}
    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    je = data.get("jd_extracted") or {}
    sc = data.get("score") or {}
    pg = data.get("progress") or {}
    rec = str(data.get("recommendation") or "")
    rmeta = ANALYZE_REC_META.get(rec, {"cls": "hold", "label": rec or "（无结论）"})
    proc, usage = clip_process(data)
    title = job_title or je.get("job_title") or meta.get("job_code") or "（未命名岗位）"

    # 一、输入与来源（本地事实，0 token）
    inputs = [
        ("岗位 JD（唯一事实输入）",
         f"<code>jd.txt</code>（{esc(meta.get('jd_bytes') or '—')} 字节）",
         "本次分析的全部事实来源；JD 非空即不应再向老板索要"),
        ("方法论手册", "<code>data/prompts/analyze_job.txt</code>",
         "决定输出 JSON 的字段与五维评分标准（本页排版也按它）"),
        ("成长规则库",
         f"<code>data/prompts/rules.md</code>{'（本次已读）' if meta.get('rules_used') else '（本次未读）'}",
         "历史纠错沉淀的规则，同一条错不重犯"),
    ]
    inputs_rows = "".join(
        f"<tr><td>{esc(a)}</td><td>{b}</td><td>{esc(c)}</td></tr>" for a, b, c in inputs)

    # 二、JD 提取
    jd_rows = "".join(
        f"<tr><td>{esc(label)}</td><td>{esc(je.get(key) or '—')}</td></tr>"
        for label, key in (("岗位名称", "job_title"), ("公司", "company"), ("城市", "city"),
                           ("薪资", "salary"), ("核心要求", "requirements"), ("岗位描述", "description")))

    # 三、逐项评分（判断结论原样搬，不截断）
    det = sc.get("details") or {}
    dim_rows = ""
    for key, label in ANALYZE_DIM_LABELS:
        d = det.get(key) or {}
        dim_rows += (f"<tr><td>{esc(label)}</td><td class='num'>{esc(d.get('score'))}</td>"
                     f"<td>{esc(d.get('value') or '—')}</td></tr>")
    dim_sum = 0
    for key, _l in ANALYZE_DIM_LABELS:
        v = (det.get(key) or {}).get("score")
        if isinstance(v, int) and not isinstance(v, bool):
            dim_sum += v

    # 六、搜索关键字
    kw = data.get("search_keywords") or {}
    kw_rows = "".join(f"<tr><td>{esc(k)}</td><td>{esc(v)}</td></tr>" for k, v in kw.items()) \
        or "<tr><td colspan='2'>（无）</td></tr>"
    kr_html = (f'<div class="box"><b>选词思路</b><p>{esc(proc["keyword_reasoning"])}</p></div>'
               if proc["keyword_reasoning"] else "")

    # 七、待核实 + 下一步
    vl_html = ("<ol>" + "".join(f"<li>{esc(x)}</li>" for x in proc["verify_list"]) + "</ol>"
               if proc["verify_list"] else '<p class="dim">（本次没给待核实清单）</p>')
    nx_html = (f'<div class="box">{esc(proc["next_step"])}</div>' if proc["next_step"]
               else '<p class="dim">（本次没给下一步建议）</p>')

    # 风险（判断结论原样搬，不截断）
    risks = [x for x in (sc.get("risks") or []) if str(x).strip()]
    risks_html = ("<ol>" + "".join(f"<li>{esc(x)}</li>" for x in risks) + "</ol>"
                  if risks else '<p class="dim">（无）</p>')

    # 页脚：长度预算用量（本地量，看得见的确认）
    if usage["present"]:
        bud = (f'过程叙述 {usage["total"]}/{usage["budget"]} 字'
               f'（选词思路 {usage["chars"]["keyword_reasoning"]}'
               f'｜待核实 {usage["chars"]["verify_list"]}'
               f'｜下一步 {usage["chars"]["next_step"]}）')
        if usage["truncated"]:
            bud += "（<b>超预算已本地截断</b>：" + "、".join(usage["truncated"]) + "）"
    else:
        bud = ("本份报告是老版本（analyze JSON 里还没有 process 叙述块）：页面内容仍全部可渲染，"
               "只少「选词思路 / 待核实 / 下一步」三小节；下一次①分析会自动带上")

    return f"""<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>岗前分析过程 · {esc(title)}</title>
<style>
  body{{font-family:-apple-system,"Segoe UI","Microsoft YaHei",sans-serif;background:#fbfbfa;margin:0;padding:26px 30px;color:#222;line-height:1.7;max-width:1000px;}}
  h1{{font-size:21px;border-bottom:3px solid #2e6fdb;padding-bottom:8px;margin:0 0 6px;}}
  h2{{font-size:16px;color:#1b4f9c;margin-top:26px;border-left:5px solid #2e6fdb;padding-left:9px;}}
  .meta{{font-size:13px;color:#666;margin:0 0 16px;}}
  .badge{{display:inline-block;padding:2px 10px;border-radius:10px;font-size:13px;color:#fff;}}
  .b-rec{{background:#2e9e5b;}} .b-hold{{background:#e08a00;}} .b-no{{background:#c0392b;}}
  table{{border-collapse:collapse;width:100%;margin:10px 0;font-size:13.5px;background:#fff;}}
  th,td{{border:1px solid #d7dbe0;padding:6px 9px;text-align:left;vertical-align:top;}}
  th{{background:#eef3fb;font-weight:600;}}
  td.num{{text-align:center;font-weight:700;width:56px;}}
  .box{{background:#fff;border:1px solid #e2e5ea;border-radius:6px;padding:10px 14px;margin:10px 0;}}
  .box p{{margin:6px 0 0;}}
  .warn{{background:#fff7e6;border-left:4px solid #e08a00;padding:10px 14px;margin:10px 0;border-radius:0 5px 5px 0;}}
  .dim{{color:#999;font-size:13px;}}
  code{{background:#f2f4f7;padding:1px 5px;border-radius:3px;font-size:12.5px;}}
  ol,ul{{margin:6px 0;padding-left:22px;}} li{{margin:4px 0;}}
  .foot{{margin-top:30px;font-size:12.5px;color:#888;border-top:1px dashed #ccc;padding-top:10px;}}
</style>
</head>
<body>

<h1>岗前分析过程文档 · {esc(title)}</h1>
<p class="meta">
岗位号：{esc(meta.get("job_code") or "—")} ｜ 岗位目录建档：{esc(meta.get("created_at") or "—")} ｜
分析产出：{esc(meta.get("analyzed_at") or _analyze_ts(meta.get("json_name") or "") or "—")} ｜
本次性质：{esc("首次分析" if meta.get("first_time") else "重跑（覆盖旧结论）")}<br>
执行步骤：① 岗前分析 ｜ 结论：<span class="badge b-{esc(rmeta['cls'])}">{esc(rmeta['label'])}（recommendation = {esc(rec or '—')}）</span>
｜ 总分 {esc(sc.get("total"))}/25 · 等级「{esc(sc.get("level") or "—")}」（五项之和 {esc(dim_sum)}）
</p>

<h2>一、这次读了什么（输入与来源）</h2>
<table>
  <tr><th>输入</th><th>文件</th><th>用途</th></tr>
  {inputs_rows}
</table>
<p class="dim">以上为本岗分析时的盘上事实（本地读盘写入本页，0 token）。本岗 reports 目录分析前已有产物
{esc(meta.get("artifacts_count", 0))} 个。</p>

<h2>二、JD 信息提取</h2>
<table>
  <tr><th style="width:120px">字段</th><th>内容</th></tr>
  {jd_rows}
</table>

<h2>三、逐项评分（判断结论原样呈现）</h2>
<table>
  <tr><th style="width:120px">维度</th><th>得分</th><th>依据</th></tr>
  {dim_rows}
  <tr><td><b>总分</b></td><td class="num">{esc(sc.get("total"))}</td>
      <td><b>{esc(sc.get("level") or "")}</b>　{esc(sc.get("advice") or "")}</td></tr>
</table>

<h2>四、进展判断</h2>
<div class="box">
<p><b>状态：</b>{esc(pg.get("status") or "—")}　<b>已推荐：</b>{esc(pg.get("recommended_count", 0))}　
<b>面试中：</b>{esc(pg.get("interviewing_count", 0))}　<b>已发 offer：</b>{esc(pg.get("offer_count", 0))}</p>
<p><b>进展影响：</b>{esc(sc.get("progress_impact") or "—")}</p>
</div>

<h2>五、风险清单</h2>
{risks_html}

<h2>六、猎聘搜索关键字（4 组）</h2>
<table>
  <tr><th style="width:120px">分组</th><th>关键词</th></tr>
  {kw_rows}
</table>
{kr_html}

<h2>七、要核实的 & 下一步</h2>
<p><b>必须先跟 PM 核实的口径</b></p>
{vl_html}
<p><b>下一步建议</b></p>
{nx_html}

<div class="foot">
本地渲染：本页全部内容来自 <code>{esc(meta.get("json_name") or "analyze_*.json")}</code> 与盘上事实，
小猎<b>没有手写本页 HTML</b>（可随时由 <code>report_html.render_analyze</code> 重生）· 渲染时间 {esc(now)}<br>
长度预算：{bud}。<b>判断结论（评分／风险／建议）不设上限、不被截断</b>——预算只掐「过程叙述」。
</div>
</body>
</html>"""


# ── ② 搜索体检 · 过程报告（本地渲染；2026-09-15 老板口径："几轮搜索 → 一份过程报告"）────
# 与 render_analyze 同一条纪律：本模块**只搬运与排版，不判断内容好坏**；
#   长度预算只掐「小猎的叙述」，**命中人数 / 校验结果这些事实一个数字都不截**。
SEARCH_BUDGET = {
    "reason": 80,       # 每轮"为什么这么设"（字符上限）
    "changed": 60,      # 每轮"改了什么"
    "conclusion": 300,  # 小猎的总结论
    "highlight": 60,    # 要点单条
    "highlights": 5,    # 要点条数
    "total": 440,       # 合计硬顶
}


def clip_search_text(trace: dict) -> tuple[dict, dict]:
    """把 trace 里**小猎写的叙述**按 SEARCH_BUDGET 收敛（本地强制）。返回 (收敛后, 用量)。"""
    usage = {"chars": {}, "truncated": [], "total": 0, "budget": SEARCH_BUDGET["total"]}
    concl, c1 = _clip(trace.get("conclusion"), SEARCH_BUDGET["conclusion"])
    if c1:
        usage["truncated"].append("总结论")
    hs, hcut = [], False
    for i, h in enumerate(trace.get("highlights") or []):
        if i >= SEARCH_BUDGET["highlights"]:
            usage["truncated"].append("要点条数")
            break
        s, cut = _clip(h, SEARCH_BUDGET["highlight"])
        hcut = hcut or cut
        if s:
            hs.append(s)
    if hcut:
        usage["truncated"].append("要点单条")
    rounds = []
    for r in trace.get("rounds") or []:
        rr = dict(r)
        rr["reason"], a = _clip(r.get("reason"), SEARCH_BUDGET["reason"])
        rr["changed"], b = _clip(r.get("changed"), SEARCH_BUDGET["changed"])
        if a:
            usage["truncated"].append(f"第{r.get('n')}轮理由")
        if b:
            usage["truncated"].append(f"第{r.get('n')}轮改动")
        rounds.append(rr)
    usage["chars"] = {"总结论": len(concl), "要点": sum(len(x) for x in hs),
                      "各轮理由": sum(len(r["reason"]) for r in rounds),
                      "各轮改动": sum(len(r["changed"]) for r in rounds)}
    usage["total"] = sum(usage["chars"].values())
    return {"conclusion": concl, "highlights": hs, "rounds": rounds}, usage


def _delta_cell(cur, prev) -> str:
    """相对上一轮的变化（本地算，不判断好坏）。"""
    if cur is None or prev is None:
        return "<span class='dim'>—</span>"
    d = cur - prev
    if d == 0:
        return "<span class='dim'>持平</span>"
    pct = f"（{d / prev * 100:+.0f}%）" if prev else ""
    return f"<span class='{'drop' if d < 0 else 'rise'}'>{d:+d}{pct}</span>"


def _killer_rows(rounds: list) -> list:
    """本地算「哪个条件砍人最多」——只用**真读数**做减法，**不做任何业务判断**。

    ⚠️ 2026-09-15 **真跑实测踩到的坑**：`input` 类条件（关键字）**不触发搜索**，它那一步读到的数是
    **上一次搜索的旧状态**。实测 5 轮的"关键字那一步"读数完全一样（`共3000+位人选`／27 个锚点，
    与关键字内容无关）→ **铁证它不是"关键字池"，而是个常量**（清空条件后的页面残留）。
    若拿它当基线，就会算出"加城市砍掉 2858 人"这种**假因果**（真跑那份报告里当场就出现了）。
    所以：`stale` 的读数**一律不参与减法**（页面上仍如实列出，只是不算进"砍人最多"）。
    """
    out = []
    for r in rounds:
        seq = [(f"{s.get('group_id')}={s.get('value')}", s.get("total"))
               for s in (r.get("steps") or [])
               if s.get("found") and s.get("total") is not None and not s.get("stale")]
        if r.get("found") and r.get("total") is not None:
            seq.append(("本轮定稿（点「搜 索」后）", r["total"]))
        best = None
        for i in range(1, len(seq)):
            lx, lv = seq[i - 1]
            cx, cv = seq[i]
            d = cv - lv
            if best is None or d < best[0]:
                best = (d, cx, lx, lv, cv)
        if best and best[0] < 0:
            out.append((r.get("n"), best[1], best[0], f"{best[2]} {best[3]} → {best[4]}"))
    return out


def render_search_rounds(job_title: str, trace: dict, meta: dict | None = None) -> str:
    """② 搜索体检 · 过程文档（本地渲染，0 token、确定性、有长度预算）。

    trace = `search_rounds.py` 落盘的《轮次轨迹》JSON（每轮关键字 / 条件 / 每步命中人数）。
    meta（全可选）：job_code / plan_file / json_name / html_name
    """
    meta = meta or {}
    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    conv, usage = clip_search_text(trace)
    rounds = conv["rounds"] or []
    title = job_title or trace.get("job_code") or "（未命名岗位）"
    dry = bool(trace.get("dry_run"))
    found_n = len([r for r in rounds if r.get("found")])

    main_rows, prev = "", None
    for r in rounds:
        tot = r.get("total")
        if r.get("found") and tot is not None:
            shown = (r.get("total_raw") or str(tot)).replace("共", "").replace("位人选", "")
            tot_cell = f"<b class='big'>{esc(shown)}</b>"
        else:
            tot_cell = "<span class='miss'>读不到</span>"
        main_rows += (
            f"<tr><td class='num'>{esc(r.get('n'))}</td><td>{esc(r.get('keyword'))}</td>"
            f"<td>{esc('、'.join(r.get('conds') or []) or '（无）')}</td>"
            f"<td class='num'>{tot_cell}</td><td>{_delta_cell(tot, prev)}</td>"
            f"<td>{esc(r.get('changed') or '—')}"
            f"<div class='dim'>{esc(r.get('reason') or '')}</div></td></tr>")
        if tot is not None:
            prev = tot

    step_rows = ""
    for r in rounds:
        for s in (r.get("steps") or []):
            if "group_id" not in s:
                continue
            v = s.get("verify")
            mark = "✅" if v else ("⚠️" if v is None else "❌")
            note = ("未触发搜索：读数是「上一次搜索」的旧状态" if s.get("stale")
                    else "即点即搜后的读数")
            step_rows += (
                f"<tr><td class='num'>{esc(r.get('n'))}</td>"
                f"<td>{esc(s.get('group_id'))}={esc(s.get('value'))}</td>"
                f"<td>{esc(s.get('type'))}</td><td>{mark}</td>"
                f"<td class='num'>{esc(s.get('total_raw') or '读不到')}</td>"
                f"<td class='dim'>{note}</td></tr>")

    kill_rows = "".join(
        f"<tr><td class='num'>{esc(n)}</td><td>{esc(cur)}</td>"
        f"<td class='num drop'>{d:+d}</td><td class='dim'>{esc(chain)}</td></tr>"
        for n, cur, d, chain in _killer_rows(rounds))

    miss = [f"第 {r.get('n')} 轮（{esc(r.get('keyword'))}）" for r in rounds if not r.get("found")]
    bad = [f"第 {r.get('n')} 轮：{esc(r.get('error'))}" for r in rounds if r.get("verify_failed")]
    warn_html = ""
    if miss:
        warn_html += ("<div class='warn'><b>读不到命中总数的轮次</b>：" + "、".join(miss) +
                      "——页面文本里没出现「共N位人选」（可能没刷新完，或文本被截掉）。"
                      "<b>这里不猜</b>：这几轮就是空的。</div>")
    if bad:
        warn_html += "<div class='warn'><b>条件没生效（verify=False，硬失败）</b>：" + "<br>".join(bad) + "</div>"
    if dry:
        warn_html += "<div class='warn'>这是一份 <b>dry-run 计划稿</b>：只体检了计划本身，<b>没有真开浏览器</b>，没有命中人数。</div>"

    concl_html = (f"<div class='box'>{esc(conv['conclusion'])}</div>" if conv["conclusion"] else
                  "<div class='warn'>小猎没有给结论（轨迹里没有 <code>conclusion</code>）——"
                  "本页只有事实，没有它的判断。</div>")
    hl_html = ("<ul>" + "".join(f"<li>{esc(h)}</li>" for h in conv["highlights"]) + "</ul>"
               if conv["highlights"] else "<p class='dim'>（未给要点）</p>")
    bud = (f"小猎的叙述共 {usage['total']}/{usage['budget']} 字"
           + (f"（已截断：{'、'.join(usage['truncated'])}）" if usage["truncated"] else "（未触顶）"))

    return f"""<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>搜索体检过程 · {esc(title)}</title>
<style>
  body{{font-family:-apple-system,"Segoe UI","Microsoft YaHei",sans-serif;background:#fbfbfa;margin:0;padding:26px 30px;color:#222;line-height:1.7;max-width:1000px;}}
  h1{{font-size:21px;border-bottom:3px solid #2e6fdb;padding-bottom:8px;margin:0 0 6px;}}
  h2{{font-size:16px;color:#1b4f9c;margin-top:26px;border-left:5px solid #2e6fdb;padding-left:9px;}}
  .meta{{font-size:13px;color:#666;margin:0 0 16px;}}
  table{{border-collapse:collapse;width:100%;margin:10px 0;font-size:13.5px;background:#fff;}}
  th,td{{border:1px solid #d7dbe0;padding:6px 9px;text-align:left;vertical-align:top;}}
  th{{background:#eef3fb;font-weight:600;}}
  td.num{{text-align:center;font-weight:700;width:76px;}}
  td.num b.big{{font-size:17px;color:#1b4f9c;}}
  .miss{{color:#c0392b;font-weight:700;}}
  .drop{{color:#c0392b;font-weight:700;}} .rise{{color:#2e9e5b;font-weight:700;}}
  .box{{background:#fff;border:1px solid #e2e5ea;border-radius:6px;padding:10px 14px;margin:10px 0;}}
  .warn{{background:#fff7e6;border-left:4px solid #e08a00;padding:10px 14px;margin:10px 0;border-radius:0 5px 5px 0;}}
  .dim{{color:#999;font-size:13px;}}
  code{{background:#f2f4f7;padding:1px 5px;border-radius:3px;font-size:12.5px;}}
  ol,ul{{margin:6px 0;padding-left:22px;}} li{{margin:4px 0;}}
  .foot{{margin-top:30px;font-size:12.5px;color:#888;border-top:1px dashed #ccc;padding-top:10px;}}
</style>
</head>
<body>

<h1>② 搜索体检 · 过程文档 · {esc(title)}</h1>
<p class="meta">
岗位号：{esc(meta.get("job_code") or trace.get("job_code") or "—")} ｜
计划文件：<code>{esc(meta.get("plan_file") or trace.get("plan_file") or "—")}</code> ｜
执行时间：{esc(trace.get("ts") or "—")}<br>
轮数 {len(rounds)} ｜ 拿到命中总数 {found_n}/{len(rounds)} 轮 ｜ 搜索约 {esc(trace.get("searches_estimate", "—"))} 次 ｜
用时 {esc(trace.get("elapsed_sec", "—"))}s ｜ tab {esc(trace.get("tab_id", "—"))}<br>
数据来源：<b>只读</b>结果页上的「共N位人选」（<b>不抓人</b>：没调 extract、没落任何候选人 id、没开详情页）
</p>

<h2>一、每轮：关键字 / 条件 / 命中总人数</h2>
<table>
  <tr><th style="width:52px">轮</th><th style="width:190px">关键字</th><th>条件</th>
      <th style="width:96px">命中总数</th><th style="width:130px">相对上轮</th><th>改了什么 / 为什么</th></tr>
  {main_rows or "<tr><td colspan='6' class='dim'>（没有轮次）</td></tr>"}
</table>
<p class="dim">命中总数 = 结果页原文「共N位人选」（含 <code>+</code> 表示平台只给到"3000+"这种量级）。</p>

<h2>二、每个条件砍掉多少人（本地算减法，不做业务判断）</h2>
<table>
  <tr><th style="width:52px">轮</th><th>砍人最多的一步</th><th style="width:90px">变化</th><th>读数链条</th></tr>
  {kill_rows or "<tr><td colspan='4' class='dim'>（读数不够，算不出「砍人最多」的一步）</td></tr>"}
</table>
<p class="dim">只统计<b>一轮之内</b>两次读数之间的变化（跨轮的变化看上面第一张表）；某轮没出现，说明那轮读数不够。
<b>标记为「旧状态」的读数（关键字那一步不触发搜索）不参与计算</b>——否则会算出"加城市砍掉 2858 人"这种假因果。</p>

<h2>三、逐步明细（每个条件设完后的读数）</h2>
<table>
  <tr><th style="width:52px">轮</th><th>条件</th><th style="width:96px">类型</th>
      <th style="width:52px">生效</th><th style="width:110px">设完后的读数</th><th>说明</th></tr>
  {step_rows or "<tr><td colspan='6' class='dim'>（没有条件明细）</td></tr>"}
</table>

{warn_html}

<h2>四、小猎的结论（它自己写的）</h2>
{concl_html}
{hl_html}

<div class="foot">
本地渲染：本页来自《轮次轨迹》<code>{esc(meta.get("json_name") or "search_rounds_*.json")}</code>，
执行与读数全部由 <code>search_rounds.py</code> 完成，<b>小猎没有手写本页 HTML</b>（可随时由
<code>report_html.render_search_rounds</code> 重生）· 渲染时间 {esc(now)}<br>
长度预算：{bud}。<b>命中人数与校验结果不设上限、不被截断</b>——预算只掐小猎的叙述。<br>
已知脆点：命中总数只能从页面纯文本<b>前 3000 字</b>里读；页面条件极多时可能读不到（读不到就如实标，不猜）。
</div>
</body>
</html>"""


def main_search() -> None:
    """CLI：把《轮次轨迹》JSON 渲染成过程网页（本地、0 token）。"""
    ap = argparse.ArgumentParser(description="本地渲染 ②搜索体检 过程网页")
    ap.add_argument("--search-rounds", required=True, type=Path, help="search_rounds_*.json（轮次轨迹）")
    ap.add_argument("--out", type=Path, default=None, help="输出 HTML（默认与轨迹同名的 _过程.html）")
    ap.add_argument("--title", default="", help="标题（岗位名）")
    args = ap.parse_args()
    p = Path(args.search_rounds)
    if not p.exists():
        print(f"❌ 轨迹文件不存在: {p}")
        sys.exit(1)
    trace = json.loads(p.read_text(encoding="utf-8-sig"))
    title = args.title or trace.get("job_code") or f"岗位 {p.parent.parent.name}"
    html = render_search_rounds(title, trace, meta={"json_name": p.name, "plan_file": trace.get("plan_file")})
    out = Path(args.out) if args.out else p.with_name(p.stem + "_过程.html")
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(html, encoding="utf-8")
    print(f"✅ 已渲染 {len(trace.get('rounds') or [])} 轮 → {out}（{out.stat().st_size} 字节）")


def main() -> None:
    ap = argparse.ArgumentParser(description="本地渲染候选人匹配/打招呼 HTML 报告")
    ap.add_argument("--report", required=True, type=Path, help="pool_report JSON（含 pool_quality + candidates）")
    ap.add_argument("--collect", type=Path, default=None, help="collected JSON（可选，取姓名/直达链接/摘要）")
    ap.add_argument("--out", type=Path, default=None, help="输出 HTML 路径（默认 stdout 同级文件名）")
    ap.add_argument("--title", default="", help="报告标题（岗位名）")
    ap.add_argument("--group", choices=["none", "verdict"], default="none", help="分组方式（none=按分排序；verdict=按判定）")
    args = ap.parse_args()

    report_path = Path(args.report)
    if not report_path.exists():
        print(f"❌ 报告文件不存在: {report_path}")
        sys.exit(1)
    data = json.loads(report_path.read_text(encoding="utf-8-sig"))
    candidates = data.get("candidates") or []
    rows = parse_collected(args.collect) if args.collect else []
    title = args.title or f"岗位 {report_path.parent.name}"
    out_html = render(title, data, candidates, rows, group=args.group)
    out = args.out or (report_path.with_name(report_path.stem + ".html"))
    out = Path(out)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(out_html, encoding="utf-8")
    print(f"✅ 已渲染 {len(candidates)} 人 → {out}（{out.stat().st_size} 字节）")


if __name__ == "__main__":
    if "--search-rounds" in sys.argv:
        main_search()
    else:
        main()
